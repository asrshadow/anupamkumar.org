---
// ============================================================
// HOME PAGE
//
// Leads with the newest thing written. That is the whole point of
// the page: a reader arriving for the first time should meet the
// writing, not a biography. The biography lives at /about/.
//
// Two columns. The reading matter is on the left, and the right
// column carries the things a reader might go to next — the other
// sections, the subjects, and where else to find this.
// ============================================================

import BaseLayout from "../layouts/BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import SideBlock from "../components/SideBlock.astro";
import FeaturedPiece from "../components/FeaturedPiece.astro";
import PieceCard from "../components/PieceCard.astro";
import { getAllWriting, getAllTags } from "../lib/writing";

const everything = await getAllWriting();

// The newest piece gets the top of the page to itself.
const featured = everything[0];

// The next four go underneath it, in the ordinary listing style.
const alsoRecent = everything.slice(1, 5);

// The subjects, for the sidebar. EIGHT, not all of them: this list
// will be forty entries long in two years, and a sidebar cannot
// hold forty. The full list is on /writing/.
const topTags = (await getAllTags()).slice(0, 8);

function displayTag(tag: string): string {
  const spaced = tag.replace(/-/g, " ");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
}
---

<BaseLayout
  title="Anupam Kumar"
  description="Writing, data and tools on public finance, public policy, economics and geoeconomics — with the aim of making economic information usable by people who are not economists."
>
  <PageShell asideLabel="Elsewhere on this site">
    <!-- THE H1 IS HERE BUT NOT SHOWN, AND BOTH HALVES OF THAT
         matter.

         It has to exist, and it has to be the name of the site
         rather than the title of an article. It is what a screen
         reader announces as the name of the page and what a search
         engine reads as its subject, so putting the newest essay's
         title here would make that essay the name of the whole
         site. Having no h1 at all leaves the page unnamed.

         It is not shown because the page should open with the
         writing. The name is already at the top left of every page
         in the header, so displaying it again immediately below
         would say the same thing twice.

         .visually-hidden keeps it available to screen readers.
         display: none would hide it from them too, which would
         defeat the point of having it. -->
    <h1 class="visually-hidden">Anupam Kumar</h1>

    {
      featured ? (
        <>
          <section aria-labelledby="latest-heading">
            <h2 id="latest-heading" class="visually-hidden">
              The most recent piece
            </h2>
            <FeaturedPiece piece={featured} />
          </section>

          {alsoRecent.length > 0 && (
            <section aria-labelledby="more-heading">
              <h2 id="more-heading" class="section-heading section-heading--ruled">
                More recent writing
              </h2>

              <div class="piece-list">
                {alsoRecent.map((piece) => (
                  <PieceCard piece={piece} />
                ))}
              </div>
            </section>
          )}

          <p class="see-all">
            <a href="/writing/">All writings and notes</a>
          </p>
        </>
      ) : (
        <p class="empty">Nothing published yet. The first pieces are coming.</p>
      )
    }

    <Fragment slot="aside">
      <SideBlock title="Datasets">
        <p>
          Cleaned Indian public finance data, each one carrying its source, the
          date it was retrieved, and every column described with its unit.
        </p>
        <p>
          <a href="/datasets/">Nothing published yet — what is coming</a>
        </p>
      </SideBlock>

      <SideBlock title="Tools">
        <p>
          Small interactive things that run entirely in your browser. Nothing
          you open is sent anywhere, because there is no server to send it to.
        </p>
        <p>
          <a href="/tools/">Nothing published yet — what is coming</a>
        </p>
      </SideBlock>

      {
        topTags.length > 0 && (
          <SideBlock title="Browse by subject">
            <ul class="tag-links">
              {topTags.map(({ tag, count }) => (
                <li>
                  <a href={`/tags/${tag}/`}>
                    {displayTag(tag)}
                    <span class="count">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="more-subjects">
              <a href="/writing/">All subjects</a>
            </p>
          </SideBlock>
        )
      }

      <SideBlock title="Elsewhere">
        <ul>
          <li><a href="https://asranupam.substack.com">Newsletter on Substack</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="mailto:hello@anupamkumar.org">hello@anupamkumar.org</a></li>
        </ul>
      </SideBlock>
    </Fragment>
  </PageShell>
</BaseLayout>

<style>
  .see-all {
    margin: var(--space-6) 0 0;
    font-size: var(--size-sm);
  }

  .empty {
    color: var(--colour-ink-muted);
    padding-block: var(--space-5);
  }

  /* Each subject sits on its own line with its count pushed to the
     right, so the numbers form a column the eye can compare. */
  .tag-links a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  /* A count is a figure, so it is mono with tabular digits like
     every other number on the site. */
  .count {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--colour-ink-muted);
  }

  /* Written as "list then paragraph" rather than just
     ".more-subjects", and that is not stylistic. SideBlock sets the
     margin on every paragraph inside it, and that rule is more
     specific than a single class here, so a simpler selector loses
     and the link ends up jammed against the last subject. */
  .tag-links + .more-subjects {
    margin-top: var(--space-4);
  }
</style>
