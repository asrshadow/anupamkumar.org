---
// ============================================================
// SITE HEADER
// The name, the navigation, and the theme toggle.
//
// Structural, so it recedes: hairline rule, no rounded corners,
// no shadow. Nothing here should compete with the writing.
// ============================================================

import ThemeToggle from "./ThemeToggle.astro";

// The current page's address, used to mark which navigation item
// the reader is on.
const path = Astro.url.pathname;

// The navigation. Adding a page means adding a line here.
// Data and Tools are deliberately absent until they exist — a
// navigation item leading to an empty page is worse than none.
const links = [
  { href: "/writing/", label: "Writing" },
  { href: "/notes/", label: "Notes" },
  { href: "/about/", label: "About" },
  { href: "/now/", label: "Now" },
  { href: "/search/", label: "Search" },
];

// A link is "current" when the address starts with it. That way
// /writing/some-essay/ still marks Writing as the current section.
function isCurrent(href: string): boolean {
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <!-- The name is a link home. On the home page itself it is
         still a link, which is the convention readers expect. -->
    <a href="/" class="wordmark">Anupam Kumar</a>

    <nav aria-label="Main">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { current: isCurrent(link.href) }]}
                {...(isCurrent(link.href) ? { "aria-current": "page" } : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--colour-rule);
    background: var(--colour-paper);
  }

  .header-inner {
    max-width: var(--width-page);
    margin: 0 auto;
    padding: var(--space-4) var(--width-gutter);

    display: flex;
    align-items: center;
    gap: var(--space-4) var(--space-6);

    /* Wrap onto a second line rather than squeezing, so nothing is
       ever cut off on a narrow screen. */
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--size-lg);
    font-weight: 700;
    color: var(--colour-ink);
    text-decoration: none;
    letter-spacing: -0.015em;

    /* Push the navigation and toggle to the right on a wide screen. */
    margin-right: auto;
  }

  .wordmark:hover {
    color: var(--colour-accent);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-2) 0;
    font-size: var(--size-sm);
    color: var(--colour-ink-muted);
    text-decoration: none;

    /* A transparent border reserves the space the current-page
       underline will occupy, so nothing shifts when it appears. */
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--colour-ink);
  }

  /* The current section. Marked by weight and an underline as well
     as colour, because colour alone must never carry meaning. */
  .nav-link.current {
    color: var(--colour-ink);
    font-weight: 600;
    border-bottom-color: var(--colour-accent);
  }

  /* On a phone the name goes on its own line above everything else. */
  @media (max-width: 34rem) {
    .header-inner {
      gap: var(--space-3);
    }

    .wordmark {
      flex-basis: 100%;
      margin-right: 0;
    }

    .nav-list {
      margin-right: auto;
    }
  }
</style>
