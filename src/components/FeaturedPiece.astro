---
// ============================================================
// FEATURED PIECE
// The newest thing written, shown at the top of the home page.
//
// It is the same information as a PieceCard, set larger, because
// it is the first and most important thing on the page.
//
// IT IS NOT A CARD. No border, no background, no shadow. A box
// around it would make it look like one item in a set, which is
// the opposite of what being featured means. The size does the
// work instead.
// ============================================================

import type { Piece } from "../lib/writing";
import { excerptOf } from "../lib/writing";
import { Image } from "astro:assets";
import PostMeta from "./PostMeta.astro";
import TagList from "./TagList.astro";

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;

// A longer summary than the listing cards get — around forty
// words, drawn from the opening of the piece.
//
// The one-sentence "description" is not used here, because it is
// also the search-engine description and those get cut off at
// about 155 characters. Making it long enough for this spot would
// spoil it there.
//
// If the piece has no usable opening paragraph — it is all
// headings, or a stub — fall back to the description rather than
// showing nothing.
const summary = excerptOf(piece, 40) || piece.description;
---

<article class="featured">
  {
    /* Larger than the thumbnail on a listing entry, because this is
       the featured piece, but still a long way short of the full
       picture inside the article. alt="" for the same reason as on
       a listing entry: the title beside it says where the link
       goes, and the picture's real description lives on the copy
       inside the piece.

       loading="eager" because this sits at the top of the home
       page. Lazy-loading something already on screen only delays
       it. */
    piece.thumbnail && (
      <a
        href={piece.url}
        class="featured-image"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image src={piece.thumbnail} alt="" width={640} loading="eager" />
      </a>
    )
  }

  <h2 class="featured-title">
    <a href={piece.url}>{piece.title}</a>
  </h2>

  <p class="featured-standfirst">{summary}</p>

  <PostMeta
    date={piece.date}
    updated={piece.updated}
    isExternal={piece.isExternal}
    substackUrl={piece.substackUrl}
  />

  <TagList tags={piece.tags} />
</article>

<style>
  .featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--colour-rule);
    margin-bottom: var(--space-7);
  }

  /* A wide, shallow crop rather than the picture's own shape. It
     sits above a title and a standfirst, and a tall image would
     push both of those off the first screen. */
  .featured-image {
    display: block;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--radius-data);
    background: var(--colour-surface-sunk);
    max-width: var(--measure);
  }

  .featured-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-title {
    /* One step below the page's own h1, and well above anything
       else on the page. */
    font-family: var(--font-serif);
    font-size: var(--size-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    margin: 0;
    text-wrap: balance;
    max-width: var(--measure);
  }

  .featured-title a {
    color: var(--colour-ink);
    text-decoration: none;
  }

  .featured-title a:hover {
    color: var(--colour-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The one-sentence description, set as a standfirst: serif and
     larger than body text, so it reads as an introduction to the
     piece rather than as the start of it. */
  .featured-standfirst {
    font-family: var(--font-serif);
    font-size: var(--size-lg);
    line-height: 1.45;
    color: var(--colour-ink-muted);
    margin: 0;
    max-width: var(--measure);
    text-wrap: pretty;
  }
</style>
