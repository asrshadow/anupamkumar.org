---
// ============================================================
// PIECE LAYOUT
// The shell around one essay or note: the title, the date, the
// text itself, the tags, and the data box.
//
// The reading column has no container of any kind. Just text on
// paper, because nothing should compete with reading.
// ============================================================

import BaseLayout from "./BaseLayout.astro";
import PageShell from "../components/PageShell.astro";
import SideBlock from "../components/SideBlock.astro";
import PostMeta from "../components/PostMeta.astro";
import TagList from "../components/TagList.astro";
import DataBox from "../components/DataBox.astro";
import type { Piece } from "../lib/writing";
import { getRelated } from "../lib/writing";

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
const data = piece.entry.data;

// Up to four other pieces sharing at least one tag with this one.
// Empty when the piece has no tags, and the block is then not
// drawn — see getRelated for why there is no fallback list.
const related = await getRelated(piece, 4);

// Which address should search engines treat as the original?
//
// For a piece written here, this page. For one written in
// Substack and archived here, the Substack post. Without this,
// the two copies compete and the ranking is split between them.
const canonicalUrl =
  data.canonical === "substack" && data.substackUrl
    ? data.substackUrl
    : undefined;
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalUrl={canonicalUrl}
  ogType="article"
>
  <PageShell asideLabel="About this piece">
    <article class="piece" data-pagefind-body>
      <header class="piece-header">
        <h1>{data.title}</h1>

        <p class="standfirst">{data.description}</p>

        <PostMeta
          date={piece.date}
          updated={piece.updated}
          isExternal={piece.isExternal}
          substackUrl={piece.substackUrl}
        />
      </header>

      {
        /* An archived Substack piece says so plainly at the top and
           links to the original, so a reader always knows which copy
           they are looking at. */
        piece.isExternal && (
          <aside class="external-notice">
            <p>
              This was first published on{" "}
              <a href={piece.substackUrl}>Substack</a>, and is archived here so
              it stays available. The version on Substack is the original.
            </p>
          </aside>
        )
      }

      <!-- The text itself. .prose sets serif, 18px, and the 68
           character reading measure. -->
      <div class="prose">
        <slot />
      </div>

      <footer class="piece-footer">
        <DataBox datasets={data.datasets} />

        {
          /* The tags appear here AND in the sidebar, on purpose: at
             the foot for someone who has read to the end, in the
             sidebar for someone deciding whether to start. */
        }
        <TagList tags={data.tags} label="Tagged" />

        {
          /* A piece written here that was also sent to the newsletter
             links out to that copy, so a reader can see the discussion
             there. */
          !piece.isExternal && piece.substackUrl && (
            <p class="cross-post">
              This was also sent to subscribers —{" "}
              <a href={piece.substackUrl}>read it on Substack</a>.
            </p>
          )
        }
      </footer>
    </article>

    <Fragment slot="aside">
      {
        /* Every block here is an h2, because the sidebar sits under
           the article's h1 and headings must not skip a level. */
        data.tags.length > 0 && (
          <SideBlock title="Tagged">
            <TagList tags={data.tags} />
          </SideBlock>
        )
      }

      {
        related.length > 0 && (
          <SideBlock title="Related">
            <ul class="related-list">
              {related.map((other) => (
                <li>
                  <a href={other.url}>{other.title}</a>
                </li>
              ))}
            </ul>
          </SideBlock>
        )
      }

      <SideBlock title="Respond">
        <p>
          There are no comments here.
          {piece.substackUrl
            ? " Replies on Substack, or by email, both reach me."
            : " Email reaches me."}
        </p>
        <ul>
          {piece.substackUrl && (
            <li>
              <a href={piece.substackUrl}>This piece on Substack</a>
            </li>
          )}
          <li><a href="mailto:hello@anupamkumar.org">hello@anupamkumar.org</a></li>
        </ul>
      </SideBlock>

      {
        /* A jump link, not a second copy: the full provenance box
           with its explanation stays in the article footer. */
        data.datasets.length > 0 && (
          <SideBlock title="Data behind this piece">
            <ul class="dataset-list">
              {data.datasets.map((id) => (
                <li>
                  <a href={`/datasets/${id}/`}>{id}</a>
                </li>
              ))}
            </ul>
          </SideBlock>
        )
      }
    </Fragment>
  </PageShell>
</BaseLayout>

<style>
  .piece-header {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--colour-rule);

    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .piece-header h1 {
    margin: 0;
  }

  /* The standfirst is the one-sentence description, set larger
     than the body so it reads as an introduction rather than as
     the first paragraph. */
  .standfirst {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--size-lg);
    line-height: 1.45;
    color: var(--colour-ink-muted);
    text-wrap: pretty;
  }

  .external-notice {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-left: 3px solid var(--colour-accent);
    background: var(--colour-accent-soft);
    border-radius: 0 var(--radius-data) var(--radius-data) 0;
  }

  .external-notice p {
    margin: 0;
    font-size: var(--size-sm);
    line-height: var(--leading-ui);
  }

  .piece-footer {
    max-width: var(--measure);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--colour-rule);

    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cross-post {
    margin: 0;
    font-size: var(--size-sm);
    color: var(--colour-ink-muted);
  }

  /* A related title can run to two or three lines in a narrow
     column, so the lines need room to breathe rather than the
     tighter spacing the sidebar uses for single-line links. */
  .related-list a {
    display: block;
    line-height: var(--leading-body);
  }

  /* A dataset id is machine-readable text, so it is set in mono —
     the same signal used for figures and code everywhere else. */
  .dataset-list a {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    overflow-wrap: anywhere;
  }
</style>

<style is:global>
  /* ============================================================
     TABLES INSIDE AN ESSAY
     Every table is wrapped in a .table-wrap box at build time, by
     the plugin in scripts/rehype-wrap-tables.mjs. That box does
     the sideways scrolling, so the page body never has to.

     The table itself is left alone deliberately. Making the table
     scroll directly, with display: block, would strip its rows and
     columns of meaning for a screen reader.

     .table-wrap is styled in base.css. Only the focus ring is set
     here, because the box is focusable so a keyboard user can
     scroll it, and anything focusable must show where it is.
     ============================================================ */
  .prose .table-wrap:focus-visible {
    outline: 3px solid var(--colour-accent);
    outline-offset: 2px;
  }

  /* Images in an essay are records too, so square corners. */
  .prose img {
    border-radius: var(--radius-data);
    margin-block: var(--space-5);
  }

  /* Footnotes, which Markdown puts at the foot of the piece. */
  .prose .footnotes {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--colour-rule);
    font-size: var(--size-base);
    color: var(--colour-ink-muted);
  }
</style>
